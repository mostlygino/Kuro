#!/bin/zsh

# THESIS: one quiet strip for workspace context, not a dashboard.
# OWN-WORLD: two floating graphite pills on bare desktop, one cool active state.
# STORY: scan the workspace, active app, media, and time.
# FIRST VIEWPORT: workspaces and app left, media and time right, middle empty.
# FORM: native macOS utility bar, restrained and text-led.
# FINISH: verified on both attached displays with event-driven updates.

export PATH="/opt/homebrew/bin:/opt/homebrew/sbin:/usr/bin:/bin:/usr/sbin:/sbin"

PLUGIN_DIR="$CONFIG_DIR/plugins"
source "$CONFIG_DIR/colors.sh"

# topmost=window puts the bar on window layer 3: above app windows, below
# Notchling's notch overlay on layer 25. topmost=on also lands on layer 25 and
# ties with Notchling, leaving the z-order between them undefined.
# The bar itself draws nothing now. It is only the container that positions the
# two pills; all fill, border, and shadow moved to the brackets at the bottom of
# this file, so the middle of the screen stays bare desktop.
#
# blur_radius stays on permanently even though the bar is transparent, and it
# costs nothing visually: a blur with no fill behind it renders identically to no
# blur. It is left on because toggling it was producing an intermittent white
# flash on hover, the blur backing compositing bright for one frame before it was
# initialised, which the menu bar's own material then sampled and amplified.
sketchybar --bar \
  position=top \
  display=all \
  height="$BAR_HEIGHT" \
  margin=10 \
  y_offset=6 \
  color="$TRANSPARENT" \
  border_width=0 \
  corner_radius=0 \
  blur_radius="$HOVER_BLUR" \
  padding_left=0 \
  padding_right=0 \
  shadow=off \
  sticky=on \
  topmost=window \
  font_smoothing=on
# No notch_width. It only feeds the `q` and `e` item positions, and the notch is
# dodged by dropping the pill below it instead of moving it sideways, so nothing
# reads the value. It was also wrong: the notch is a fixed slice of the panel,
# so its width in points tracks the scaling, and the 220 that used to sit here
# is 185 at the 1512x982 default.

defaults=(
  icon.drawing=off
  y_offset="$PILL_Y"
  label.font="$BAR_FONT:$BAR_FONT_WEIGHT:$BAR_FONT_SIZE"
  label.color="$TEXT_COLOR"
  label.padding_left=7
  label.padding_right=7
  padding_left=1
  padding_right=1
  background.drawing=off
)
sketchybar --default "${defaults[@]}"

sketchybar --add event aerospace_workspace_change
sketchybar --add event aerospace_focus_change

# The aqua gloss went with the full-width slab. It was a PNG rendered at each
# display's exact bar width, and a pill resizes every time the app name changes,
# so a natural-size image could never track it. Its renderer and plugin were kept
# on disk for a while "in case the slab comes back", which is what git is for;
# they are in the history under assets/gloss.swift and plugins/gloss.sh.

# Pure spacer, and it has to be a bracket *member* to do anything useful. The
# first workspace chip is a filled circle sitting in the pill's fully rounded
# left cap, and at a 3pt item padding it cleared that arc by only ~4pt, which
# reads as glued to the corner.
#
# Widening the bracket instead (a more negative background.padding_left) does not
# work here: the bar margin is only 10pt, so pushing the pill's fill further left
# runs it off the screen edge rather than moving the chip inward. The gap has to
# come from inside the pill, and putting it on the workspace items themselves
# would also widen every gap between chips. Hence one empty item.
#
# `width=7` is load-bearing, not decoration. Left out, the item auto-sizes to -1
# and comes back *wider*, pushing the first chip from x=20 to x=32.
#
# Careful when tuning any of this: a live `sketchybar --set` does not re-run
# layout for size properties. Item width and bracket padding only take effect on
# `--reload`, so a sweep driven by `--set` reports no change and looks inert when
# it is anything but.
sketchybar --add item left_pad left \
  --set left_pad \
    icon.drawing=off \
    label.drawing=off \
    width=7 \
    padding_left=3 \
    padding_right=1 \
    background.drawing=off

for sid in {1..10} S; do
  sketchybar --add item "workspace.$sid" left \
    --set "workspace.$sid" \
      drawing=off \
      label="$sid" \
      label.font="$BAR_FONT:$BAR_FONT_WEIGHT:$BAR_FONT_SIZE" \
      label.color="$MUTED_COLOR" \
      label.width=23 \
      label.align=center \
      label.padding_left=0 \
      label.padding_right=0 \
      padding_left=3 \
      padding_right=3 \
      background.drawing=on \
      background.height="$CHIP_HEIGHT" \
      background.corner_radius=12.5 \
      background.color="$TRANSPARENT" \
      click_script="$PLUGIN_DIR/workspace_click.sh '$sid'"
done

# The agent chip, one per display, after the numbers: the hidden agent spaces
# F1 to F12 (aerospace.toml) in TestFlight's colours, a white propeller on its
# blue. Solid, with the space's name, on a display that is showing one; on the
# main display, a quiet blue propeller and a count while agents have windows
# out of sight. A click goes to the next agent space with windows.
for did in {1..3}; do
  sketchybar --add item "workspace.agent.$did" left \
    --set "workspace.agent.$did" \
      drawing=off \
      display="$did" \
      icon="$AGENT_ICON" \
      icon.drawing=on \
      icon.font="Hack Nerd Font:Bold:13" \
      icon.color="$AGENT_BLUE" \
      icon.padding_left=8 \
      icon.padding_right=4 \
      label.font="$BAR_FONT:$BAR_FONT_WEIGHT:$BAR_FONT_SIZE" \
      label.color="$AGENT_BLUE" \
      label.padding_left=0 \
      label.padding_right=9 \
      padding_left=3 \
      padding_right=3 \
      background.drawing=on \
      background.height="$CHIP_HEIGHT" \
      background.corner_radius=12.5 \
      background.color="$TRANSPARENT" \
      click_script="$PLUGIN_DIR/agent_space.sh next"
done

# One app label per display: bright when that display holds focus, muted when it
# just reports what is sitting there. Extra ids stay hidden until a display exists.
#
# Neither these nor the workspace chips run a script of their own any more:
# `aerospace_sync` below updates all of them in one pass. See
# plugins/aerospace_sync.sh for why fourteen scripts asking AeroSpace at once,
# on every monitor change, was what crashed it.
for did in {1..3}; do
  sketchybar --add item "front_app.$did" left \
    --set "front_app.$did" \
      drawing=off \
      display="$did" \
      label.color="$MUTED_COLOR" \
      label.max_chars=24 \
      label.padding_left=7 \
      icon.drawing=off \
      icon.width=16 \
      icon.padding_left=12 \
      icon.padding_right=0 \
      icon.background.drawing=on \
      icon.background.color="$TRANSPARENT" \
      icon.background.image.scale="$APP_ICON_SCALE" \
      label.padding_right="$PILL_TEXT_PAD" \
      click_script="${FRONT_APP_CLICK:-}"
done

# The single script behind all of the above. Invisible, and `updates=on` because
# a hidden item otherwise gets no events at all.
sketchybar --add item aerospace_sync left \
  --set aerospace_sync \
    drawing=off \
    updates=on \
    width=0 \
    script="$PLUGIN_DIR/aerospace_sync.sh" \
  --subscribe aerospace_sync \
    front_app_switched \
    aerospace_focus_change \
    aerospace_workspace_change \
    display_change \
    system_woke

# The clock is the time and nothing else. The week number and the date lived
# beside it until 2026-09-29, in a muted second item; now they are in its card,
# which a right-click opens, with the month drawn out and a row that opens the
# calendar. A left click is Notification Center, as it is on the real clock.
#
# The card follows the rest of the bar's rows, grey context left and answer
# right, around one image row: assets/monthmark draws the month, week numbers
# down the side and today on a white disc. A popup row as tall as its image is
# measured, not assumed: a 150pt image row pushed the row under it down by 150.
sketchybar --add item clock right \
  --set clock \
    update_freq=10 \
    icon.drawing=off \
    label.font="$BAR_FONT:$BAR_FONT_WEIGHT:$BAR_FONT_SIZE" \
    label.color="$TEXT_COLOR" \
    label.padding_left="$PILL_TEXT_PAD" \
    label.padding_right="$PILL_TEXT_PAD" \
    script="$PLUGIN_DIR/clock.sh" \
    click_script="$PLUGIN_DIR/card_click.sh clock" \
    popup.align=right \
    popup.y_offset="$CARD_Y_OFFSET" \
    popup.height="$CARD_ROW_HEIGHT" \
    popup.background.drawing=on \
    popup.background.color="$PILL_COLOR" \
    popup.background.border_width=1 \
    popup.background.border_color="$BORDER_COLOR" \
    popup.background.corner_radius=12 \
    popup.background.shadow.drawing=on \
    popup.background.shadow.color="$SHADOW_COLOR" \
    popup.background.shadow.distance=4 \
    popup.background.shadow.angle=270 \
  --subscribe clock system_woke

# Today, the week, the day of the year, the month, and the calendar. clock.sh
# fills them on its tick, so the card never waits on `date` to open. Every row
# but the image opens the calendar too: a card about the date is a way in to it.
for row in today week year month calendar; do
  sketchybar --add item "clock.$row" popup.clock \
    --set "clock.$row" \
      y_offset=0 \
      icon.drawing=on \
      icon.width="$CARD_CONTEXT_WIDTH" \
      icon.align=left \
      icon.font="$BAR_FONT:$BAR_FONT_WEIGHT:$CARD_FONT_SIZE" \
      icon.color="$MUTED_COLOR" \
      icon.padding_left="$CARD_TEXT_PAD" \
      icon.padding_right=0 \
      label.font="$BAR_FONT:$BAR_FONT_WEIGHT:$CARD_FONT_SIZE" \
      label.color="$TEXT_COLOR" \
      label.width="$CARD_VALUE_WIDTH" \
      label.align=right \
      label.padding_left=0 \
      label.padding_right="$CARD_TEXT_PAD" \
      background.drawing=off \
      click_script="$CLOCK_CLICK"
done
# The month is an image and no text, as wide as a text row measures on the bar,
# 176 + 104: the text paddings fall inside those widths. Set to the sum with the
# paddings added, 304, it pushed the card out and left the rows' values 36pt
# short of its right edge.
sketchybar --set clock.month \
    icon.drawing=off \
    label.drawing=off \
    width=$(( CARD_CONTEXT_WIDTH + CARD_VALUE_WIDTH )) \
    background.drawing=on \
    background.color="$TRANSPARENT" \
    background.image.drawing=on \
    background.image.scale=0.5 \
  --set clock.calendar label.color="$CLOCK_ACCENT"

# Spacing on this run of badges is carried by each one's `padding_right` alone,
# and the numbers are measured rather than derived. An item with an explicit
# `width` swallows its own `padding_left` entirely, and its `padding_right` does
# not push its neighbours either: it slides the item's own image left, one point
# per point, inside a slot that stays `width` wide. Measured by stepping the
# shield's padding_right from 16 to 60 and watching the burst beside it not move.
# So each badge is placed by its own number, and the numbers come from what is
# drawn. The burst and the battery run to the edges of their boxes; the shield
# symbol sits inside its 16pt box, ink from about 3pt to 13.5pt.
#
# The three sit in their own pill, `badge_pill`. A bracket spans each member's
# image plus its paddings, so the burst's padding_left is the pill's inset on
# the left and the battery's padding_right its inset on the right, while the
# gaps between the badges still come from padding_right sliding each image:
#
#   pill inset, both ends:  BADGE_INSET, as padding_left on the burst and
#                           padding_right on the battery
#   shield  -> Wi-Fi:       padding_right = Wi-Fi's + ITEM_GAP - 2
#   burst   -> shield:      padding_right = shield's + ITEM_GAP - 3
#
# The bracket's right edge sits on the next item's slot whatever the paddings
# say, so the gap to the clock pill is a spacer item, `badge_gap`, the same way
# `pill_gap` separates the two pills on the left.
#
# 10pt matches the clock pill, measured from its border to the first glyph.
BADGE_INSET=10
# The badges, left to right, and the ones this bar has (KURO_BADGES, colors.sh).
# A badge that is off is never made: no item, no card, no script, so the Claude
# one never touches the keychain and the vitals one never polls.
BADGE_ORDER=(orbstack caffeinate vitals claude tailscale wifi battery)
badge_on() { [[ " $KURO_BADGES " == *" $1 "* ]]; }

# Where each mark's ink sits in its box, left and right, in points: the battery
# ring, the burst and the Wi-Fi dots (a 26pt box, the rest are 18) run edge to
# edge, the drawn shield from 2 to 16, the ghost 1pt in from the left and 2 from
# the right, the capsule 2 and 1, the orb 2 and 2. Measured on the bar rather
# than computed, because antialiased edges read differently at this size.
typeset -A INK_L INK_R PAD_L PAD_R
INK_L=(orbstack 2 caffeinate 2 vitals 1 claude 0 tailscale 2 wifi 0 battery 0)
INK_R=(orbstack 2 caffeinate 1 vitals 2 claude 0 tailscale 2 wifi 0 battery 0)

# Each badge's padding_right leaves ITEM_GAP of clear desktop between its ink
# and its right neighbour's, so it is the neighbour's plus the gap less the two
# margins that face each other: it builds from the right edge, over the badges
# that are on. A fixed chain, as this was until 2026-10-20, left a gap twice the
# size wherever a badge was taken out. The rightmost carries the pill's inset;
# every badge's padding_left is the inset less its left margin, which only shows
# on whichever one is leftmost (OrbStack, while it runs, then the capsule).
prev=""
for (( i = ${#BADGE_ORDER}; i >= 1; i-- )); do
  b=${BADGE_ORDER[$i]}
  badge_on "$b" || continue
  if [[ -z "$prev" ]]; then PAD_R[$b]=$(( BADGE_INSET - INK_R[$b] ))
  else PAD_R[$b]=$(( PAD_R[$prev] + ITEM_GAP - INK_R[$b] - INK_L[$prev] )); fi
  PAD_L[$b]=$(( BADGE_INSET - INK_L[$b] ))
  prev=$b
done
unset prev b

sketchybar --add item badge_gap right \
  --set badge_gap \
    display=1 \
    width="$ITEM_GAP" \
    icon.drawing=off \
    label.drawing=off \
    label.padding_left=0 \
    label.padding_right=0 \
    padding_left=0 \
    padding_right=0 \
    background.drawing=off

#
# The battery, sitting immediately right of the VPN shield so the two
# machine-state badges read as a pair with the clock pill still anchoring the
# end of the bar. Added *before* tailscale, because right items lay out from the
# right edge inward in order of addition, so earlier means further right.
#
# A drawn ring, like the Claude badge: see assets/batterymark.swift. Same
# consequences here, so the same three lines: `width=16` is the
# image's exact width in points and SketchyBar does not clip a background image
# to its item, `background.image.scale=0.5` because the PNG is drawn at two
# pixels per point, and both label
# paddings pinned to 0 because menubar_reveal.sh restores with a blanket
# `label.drawing=on` and an empty label that is drawing still holds its padding.
#
# `power_source_change` is the event that matters: plugging in or pulling the
# cable should land immediately, not up to a minute later. The 60s timer is only
# for the slow drift of the level itself.
sketchybar --add item battery right \
  --set battery \
    drawing=off \
    display=1 \
    update_freq=60 \
    width=18 \
    icon.drawing=off \
    icon.padding_left=0 \
    icon.padding_right=0 \
    label.drawing=off \
    label.padding_left=0 \
    label.padding_right=0 \
    padding_left="${PAD_L[battery]}" \
    padding_right="${PAD_R[battery]}" \
    background.drawing=on \
    background.color="$TRANSPARENT" \
    background.height=18 \
    background.image.drawing=on \
    background.image.scale=0.5 \
    script="$PLUGIN_DIR/battery.sh" \
    popup.align=right \
    popup.y_offset="$CARD_Y_OFFSET" \
    popup.height="$CARD_ROW_HEIGHT" \
    popup.background.drawing=on \
    popup.background.color="$PILL_COLOR" \
    popup.background.border_width=1 \
    popup.background.border_color="$BORDER_COLOR" \
    popup.background.corner_radius=12 \
    popup.background.shadow.drawing=on \
    popup.background.shadow.color="$SHADOW_COLOR" \
    popup.background.shadow.distance=4 \
    popup.background.shadow.angle=270 \
    click_script="$PLUGIN_DIR/card_click.sh battery" \
  --subscribe battery power_source_change system_woke

# What the drawn level cannot say: the number itself, where the power is coming
# from, how long it lasts, and whether the cell is still healthy rather than
# merely full. Same two-column card as the Claude and Tailscale popups, grey
# context left, answer right, right-aligned so the values line up in a column.
#
# Slot widths rather than item width, and `y_offset=0` against the `--default`
# of 16: see the note on the Claude rows, both traps are the same here.
#
# Two of these rows can go missing. battery.sh drops the condition row when
# system_profiler cannot answer and the draw row when power telemetry reports
# nothing, rather than filling either with a guess, so the card is three rows
# tall in the worst case and five in the normal one.
for row in charge power draw remaining health; do
  sketchybar --add item "battery.$row" popup.battery \
    --set "battery.$row" \
      y_offset=0 \
      icon.drawing=on \
      icon.width="$CARD_CONTEXT_WIDTH" \
      icon.align=left \
      icon.font="$BAR_FONT:$BAR_FONT_WEIGHT:$CARD_FONT_SIZE" \
      icon.color="$MUTED_COLOR" \
      icon.padding_left="$CARD_TEXT_PAD" \
      icon.padding_right=0 \
      label.font="$BAR_FONT:$BAR_FONT_WEIGHT:$CARD_FONT_SIZE" \
      label.color="$TEXT_COLOR" \
      label.width="$CARD_VALUE_WIDTH" \
      label.align=right \
      label.padding_left=0 \
      label.padding_right="$CARD_TEXT_PAD" \
      background.drawing=off \
      click_script="/usr/bin/open 'x-apple.systempreferences:com.apple.preference.battery'"
done

# Wi-Fi, between the Tailscale shield and the battery. Four drawn dots lit as
# far as the signal reaches; the card
# has the network, signal and noise, band and channel, link rate, security,
# this Mac's address, the router and the internet with their round trips, and
# a row that turns Wi-Fi off or on. See plugins/wifi.sh and assets/wifiinfo.
sketchybar --add item wifi right \
  --set wifi \
    drawing=off \
    display=1 \
    update_freq=5 \
    width=26 \
    icon.drawing=off \
    icon.padding_left=0 \
    icon.padding_right=0 \
    label.drawing=off \
    label.padding_left=0 \
    label.padding_right=0 \
    padding_left="${PAD_L[wifi]}" \
    padding_right="${PAD_R[wifi]}" \
    background.drawing=on \
    background.color="$TRANSPARENT" \
    background.height=18 \
    background.image.drawing=on \
    background.image.scale=0.5 \
    popup.align=right \
    popup.y_offset="$CARD_Y_OFFSET" \
    popup.height="$CARD_ROW_HEIGHT" \
    popup.background.drawing=on \
    popup.background.color="$PILL_COLOR" \
    popup.background.border_width=1 \
    popup.background.border_color="$BORDER_COLOR" \
    popup.background.corner_radius=12 \
    popup.background.shadow.drawing=on \
    popup.background.shadow.color="$SHADOW_COLOR" \
    popup.background.shadow.distance=4 \
    popup.background.shadow.angle=270 \
    script="$PLUGIN_DIR/wifi.sh" \
    click_script="$PLUGIN_DIR/card_click.sh wifi" \
  --subscribe wifi wifi_change system_woke

for row in network since internet signal radio rate security address router toggle; do
  case "$row" in
    network) action="$PLUGIN_DIR/wifi.sh network" ;;
    toggle)  action="$PLUGIN_DIR/wifi.sh toggle" ;;
    *)       action="/usr/bin/open 'x-apple.systempreferences:com.apple.wifi-settings-extension'" ;;
  esac
  sketchybar --add item "wifi.$row" popup.wifi \
    --set "wifi.$row" \
      drawing=off \
      y_offset=0 \
      icon.drawing=on \
      icon.width="$CARD_CONTEXT_WIDTH" \
      icon.align=left \
      icon.font="$BAR_FONT:$BAR_FONT_WEIGHT:$CARD_FONT_SIZE" \
      icon.color="$MUTED_COLOR" \
      icon.padding_left="$CARD_TEXT_PAD" \
      icon.padding_right=0 \
      label.font="$BAR_FONT:$BAR_FONT_WEIGHT:$CARD_FONT_SIZE" \
      label.color="$TEXT_COLOR" \
      label.width="$CARD_VALUE_WIDTH" \
      label.align=right \
      label.padding_left=0 \
      label.padding_right="$CARD_TEXT_PAD" \
      background.drawing=off \
      click_script="$action"
done

# Right items lay out right-edge inward in add order, so adding tailscale
# after the clock puts it left of the clock pill.
#
# Image-only, no label: a shield reads as a VPN state badge at a glance, the
# same way the native menu bar's own VPN icon does. Drawn by assets/vpnmark in
# four states, up, down, pending and attention, with the check drawing itself
# in; it was an SF Symbol and before that a Nerd Font glyph.
# Sizing follows the Claude badge: `width` is the image's width in points,
# scale 0.5 for the 2x render, label paddings pinned to 0 for the
# menubar_reveal.sh reason given there.
# `padding_right` places it; see the spacing note above the battery.
sketchybar --add item tailscale right \
  --set tailscale \
    display=1 \
    update_freq=5 \
    width=18 \
    icon.drawing=off \
    icon.padding_left=0 \
    icon.padding_right=0 \
    padding_left="${PAD_L[tailscale]}" \
    padding_right="${PAD_R[tailscale]}" \
    label.drawing=off \
    label.padding_left=0 \
    label.padding_right=0 \
    script="$PLUGIN_DIR/tailscale.sh" \
    background.drawing=on \
    background.color="$TRANSPARENT" \
    background.height=18 \
    background.image.drawing=on \
    background.image.scale=0.5 \
    popup.align=right \
    popup.y_offset="$CARD_Y_OFFSET" \
    popup.height="$CARD_ROW_HEIGHT" \
    popup.background.drawing=on \
    popup.background.color="$PILL_COLOR" \
    popup.background.border_width=1 \
    popup.background.border_color="$BORDER_COLOR" \
    popup.background.corner_radius=12 \
    popup.background.shadow.drawing=on \
    popup.background.shadow.color="$SHADOW_COLOR" \
    popup.background.shadow.distance=4 \
    popup.background.shadow.angle=270 \
    click_script="$PLUGIN_DIR/card_click.sh tailscale" \
  --subscribe tailscale system_woke

# What the shield cannot say, plus the two things worth doing from here: the
# exit node row turns the exit node on or off (tailscale.sh exit), the last row
# connects or disconnects the tunnel (tailscale.sh toggle), and the others open
# the app. The tunnel row is an optional SSH port forward from local.sh
# (TUNNEL_AGENT), switched hard on and off through launchd (tailscale.sh
# tunnel); without it the row stays hidden. The first three rows are in the same two-column shape as the
# Claude popup: grey context on the left, the answer in white on the right,
# right-aligned so the values line up in a column down the card. Clicking the
# shield opens and closes it; see the note on the Claude rows for why this is
# not a hover.
#
# Slot widths rather than item width, and `y_offset=0` against the `--default`
# of 16: see the note on the Claude rows, both traps are the same here.
#
# Widths shared with the other cards; see CARD_CONTEXT_WIDTH in colors.sh.
for row in state since address exit tunnel toggle; do
  sketchybar --add item "tailscale.$row" popup.tailscale \
    --set "tailscale.$row" \
      y_offset=0 \
      icon.drawing=on \
      icon.width="$CARD_CONTEXT_WIDTH" \
      icon.align=left \
      icon.font="$BAR_FONT:$BAR_FONT_WEIGHT:$CARD_FONT_SIZE" \
      icon.color="$MUTED_COLOR" \
      icon.padding_left="$CARD_TEXT_PAD" \
      icon.padding_right=0 \
      label.font="$BAR_FONT:$BAR_FONT_WEIGHT:$CARD_FONT_SIZE" \
      label.color="$TEXT_COLOR" \
      label.width="$CARD_VALUE_WIDTH" \
      label.align=right \
      label.padding_left=0 \
      label.padding_right="$CARD_TEXT_PAD" \
      background.drawing=off \
      click_script="$(case "$row" in
        toggle) print -r -- "$PLUGIN_DIR/tailscale.sh toggle" ;;
        exit)   print -r -- "$PLUGIN_DIR/tailscale.sh exit" ;;
        tunnel) print -r -- "$PLUGIN_DIR/tailscale.sh tunnel" ;;
        *)      print -r -- "/usr/bin/open -a Tailscale" ;;
      esac)"
done

# Claude Code usage, drawn as a burst that goes out ray by ray over the session.
# Added after tailscale so it lands to the shield's left, and sized to sit beside
# it as a second status badge rather than as a second kind of thing.
#
# The mark is a PNG from assets/usagemark rather than a glyph, so neither `icon`
# nor `label` is ever drawn here. Both paddings are pinned to 0 for the reason
# given above the media items: menubar_reveal.sh restores with a blanket
# `label.drawing=on`, and an empty label that is drawing still holds its padding.
#
# `width=16` is not decoration, it is the rendered image's exact width in points.
# SketchyBar does not clip `background.image` to the item box, so an item
# narrower than its image reports the image's rect and draws over its
# neighbours. Change one and change the other; the size lives in usagemark.swift.
#
# `background.image.scale=0.5` with no corner radius: the PNG is drawn at two
# pixels per point, so it is crisp on the Retina panel, and it already carries
# its own shape, so there is nothing to round off.
#
# `drawing=off` at birth. The image is one of a hundred states and only the
# plugin knows which, so the item stays empty until the first tick rather than
# flashing a stale mark at every reload, and stays off when a lookup fails.
#
# 300s, up from 120. The endpoint rate-limits harder than expected: a single
# curl that returned 200 was followed a minute later by a 429 on the next poll,
# so the budget is small and it is shared with whatever else asks. Five minutes
# still resolves a five-hour window finely enough to act on, and the card carries
# the reset times for anyone who wants the exact edge. system_woke matters too:
# the lid can be shut across most of a session, and the mark would otherwise sit
# on a pre-sleep value until the next tick.
sketchybar --add item claude right \
  --set claude \
    drawing=off \
    display=1 \
    update_freq=300 \
    width=18 \
    icon.drawing=off \
    icon.padding_left=0 \
    icon.padding_right=0 \
    label.drawing=off \
    label.padding_left=0 \
    label.padding_right=0 \
    padding_left="${PAD_L[claude]}" \
    padding_right="${PAD_R[claude]}" \
    background.drawing=on \
    background.color="$TRANSPARENT" \
    background.height=18 \
    background.image.drawing=on \
    background.image.scale=0.5 \
    background.corner_radius=11 \
    popup.align=right \
    popup.y_offset="$CARD_Y_OFFSET" \
    popup.height="$CARD_ROW_HEIGHT" \
    popup.background.drawing=on \
    popup.background.color="$PILL_COLOR" \
    popup.background.border_width=1 \
    popup.background.border_color="$BORDER_COLOR" \
    popup.background.corner_radius=12 \
    popup.background.shadow.drawing=on \
    popup.background.shadow.color="$SHADOW_COLOR" \
    popup.background.shadow.distance=4 \
    popup.background.shadow.angle=270 \
    script="$PLUGIN_DIR/claude_usage.sh" \
    click_script="$PLUGIN_DIR/card_click.sh claude" \
  --subscribe claude system_woke

# What the badge cannot say. The burst is eight rays of one number; these two
# rows are the numbers it was made from, plus when each of them comes back.
#
# Opened by clicking the badge (plugins/card_click.sh), closed by clicking it
# again or leaving it, driven by assets/hoverwatch.swift rather than by
# SketchyBar's own mouse events, which are not usable on this bar: measured with
# a probe item and the pointer parked on it, thirteen `mouse.exited` in three
# seconds and no `mouse.entered` at all, because the Now Playing disc spins at
# 24fps and every frame re-evaluates hover. Alt-click opens the usage page.
#
# A popup rather than a widening item: the detail is two lines of text, and any
# item that grows would shove the clock sideways every time it opened.
#
# Both rows are filled by claude_usage.sh from the last poll, never on click, so
# the popup opens full rather than filling in a beat later. They carry no value
# here at all, not even a placeholder: an unfilled popup should not open, and the
# script only opens it when it has something to put in it.
#
# Three numbers are load-bearing here and none of them are free choice.
#
# `popup.height=26` on the parent sets the row band, and doubles as the card's
# vertical padding: the popup fill wraps the rows exactly, so the only air above
# the first line and below the last is whatever the band leaves around the text.
# Left out it is the bar's own height, and the bar is a 66pt transparent
# container, so two rows of 12pt text came out as a card the height of three
# lines with both of them stranded at the top of their own band.
#
# `y_offset=0` on the rows, against the `--default` of 16. That default exists to
# pull items up into the top 34pt of that same 66pt band, and inside a popup
# there is no band to pull out of: it just pushed the text off its row.
#
# The two columns are aligned by `icon.width` and `label.width`, not by the
# item's own `width`. That was the whole bug behind the first two attempts at
# this popup: `label.align=right` aligns text inside the label's box, and that
# box is only as wide as the text unless it is told otherwise, so widening the
# item just padded the row on the outside and left the grey context and the
# white number touching in the middle. Fixed slot widths also keep the numbers
# in a column across both rows, which is the point of stacking them.
#
# The widths come from colors.sh and are shared with the other cards, so the row
# does not change shape as the pointer moves from one badge to the next.
for row in session week; do
  sketchybar --add item "claude.$row" popup.claude \
    --set "claude.$row" \
      y_offset=0 \
      icon.drawing=on \
      icon.width="$CARD_CONTEXT_WIDTH" \
      icon.align=left \
      icon.font="$BAR_FONT:$BAR_FONT_WEIGHT:$CARD_FONT_SIZE" \
      icon.color="$MUTED_COLOR" \
      icon.padding_left="$CARD_TEXT_PAD" \
      icon.padding_right=0 \
      label.font="$BAR_FONT:$BAR_FONT_WEIGHT:$CARD_FONT_SIZE" \
      label.color="$TEXT_COLOR" \
      label.width="$CARD_VALUE_WIDTH" \
      label.align=right \
      label.padding_left=0 \
      label.padding_right="$CARD_TEXT_PAD" \
      background.drawing=off \
      click_script="/usr/bin/open 'https://claude.ai/settings/usage'"
done

