# The card: OrbStack itself, one row per machine and Compose project, and a
# quit row at the bottom. Every row is a button, which is the point of this
# card rather than the others: the header opens OrbStack, the last row quits
# it, and a machine or project row has
# two halves: its name opens its site in the browser, starting it first if it
# is stopped, and its state starts or stops it. Rows are slots the plugin fills
# and hides, because the number of projects changes and SketchyBar cannot add
# popup members from a poll without the card resizing in front of you.
# The running machines and projects, then "Nothing running" when there are
# none, then Quit all. orbstack.sh shows the rows in use.
orb_rows=()
for (( i = 0; i < 20; i++ )); do orb_rows+=("row.$i"); done
orb_rows+=(empty quit)
for row in "${orb_rows[@]}"; do
  case "$row" in
    empty)  action="open" ;;
    quit)   action="quit" ;;
    *)      action="click ${row#row.}" ;;
  esac
  sketchybar --add item "orbstack.$row" popup.orbstack \
    --set "orbstack.$row" \
      drawing=$([[ "$row" == quit ]] && print on || print off) \
      y_offset=0 \
      icon.drawing=on \
      icon.width="$CARD_CONTEXT_WIDTH" \
      icon.align=left \
      icon.font="$BAR_FONT:$BAR_FONT_WEIGHT:$CARD_FONT_SIZE" \
      icon.color="$MUTED_COLOR" \
      icon.padding_left="$CARD_TEXT_PAD" \
      icon.padding_right=0 \
      label.font="$BAR_FONT:$BAR_FONT_WEIGHT:$CARD_FONT_SIZE" \
      label.color="$TEXT_COLOR" \
      label.width="$CARD_VALUE_WIDTH" \
      label.align=right \
      label.padding_left=0 \
      label.padding_right="$CARD_TEXT_PAD" \
      background.drawing=off \
      click_script="$PLUGIN_DIR/orbstack.sh $action"
done

# `display=1` keeps this off every screen but the main one. SketchyBar numbers
# displays the way macOS arranges them, so 1 is the display carrying the menu
# bar; `display=main` is not a value it understands and silently draws nowhere,
# which is worth knowing before trying it. Workspaces, the app label and the
# clock stay on every screen, because those describe the screen they are on. The
# player and the badges describe the machine, and one machine does not need
# saying three times.
#
# Now Playing sits in its own pill on the left, directly beside the workspace
# pill, as of 2026-09-25. It lived in the centre from 2026-09-07 until then. The
# move puts the two things that describe what you are doing side by side on the
# left, and leaves the right-hand end to the things you act on: the badges and
# the clock.
#
# Left items lay out in order of addition, left to right, so these come after
# the app label and the disc is added first and reads disc then title.
#
# The centre placement needed plugins/media_notch.sh, which dropped the pill
# below the MacBook notch whenever the panel was the only display, because the
# true centre of that bar is exactly where the notch is. Nothing on the left
# sits under the notch, so the plugin and its watcher item are gone; they are in
# the history for the day the pill moves back.
#
# Title and artist are **two items**, not two slots on one item. They were one
# item until 2026-09-07, using `icon` as a second text field because a SketchyBar
# label is a single colour with no rich text. They had to split because
# `click_script` is per item and the two now do different things: the disc and
# title toggle play/pause, the artist opens Spotify.
#
# mediawatch owns both values, and hides `media_artist` outright when a track has
# no artist rather than leaving an empty slot holding padding. During Spotify DJ
# speech it hides the title, separator and artist and shows `media_wave` in their
# place; `media_disc` stays drawn and spinning, so the pill never empties out.
#
# **Add order is layout order** inside a position, which is why `media_wave` is
# added after `media_disc` and not before. Added first, it drew to the disc's
# left and pushed the cover onto the pill's right edge, half of it hanging off
# the rounded end.
#
# The 204 below is only a fallback. It used to be described as matching the track
# items so the pill would not jump, which was never true: the four track items
# are auto-sized, so the pill is however wide the title happens to make it.
# Measured against real tracks that was 174, 210, 223, 267 and 345pt. mediawatch
# reads the pill's real width back off the bracket with `--query` and renders the
# waveform 2pt under it, so this value only applies if that measurement fails.
# The pill, not the text run: the cover is hidden for a DJ segment, so the wave is
# the bracket's only member and has to cover the disc's slot as well.
#
# The width must always match the rendered image's width. SketchyBar does not
# clip `background.image` to the item box: a 204px image in a 60pt item reports a
# 204pt rect and draws straight over its neighbours.
# Zero label padding on the two items that draw their text through `icon` or an
# image, and never through `label`. `label.drawing=off` is not enough on its own:
# menubar_reveal.sh restores with a blanket `--set '/.*/' label.drawing=on`, which
# switches these back on, and an empty label that is drawing still holds its
# padding. That phantom padding was making the centre pill lead 7pt wider than it
# trailed. With the padding at 0 the drawing flag stops mattering.
# The gap between the workspace pill and the media pill. A spacer item rather
# than padding on either neighbour: the cover has an explicit `width`, and an
# item with one swallows its own `padding_left`, so the gap has to be an item of
# its own. Same reasoning, and same `width` trap, as `left_pad` above. On the
# other screens the media pill does not exist and this is trailing air nobody
# can see.
#
# Its width is the clear desktop between the two pills, measured on screen
# border to border, so it is ITEM_GAP itself: the same air as between the badges.
sketchybar --add item pill_gap left \
  --set pill_gap \
    display=1 \
    icon.drawing=off \
    label.drawing=off \
    label.padding_left=0 \
    label.padding_right=0 \
    width="$ITEM_GAP" \
    padding_left=0 \
    padding_right=0 \
    background.drawing=off

# padding_left 10, like every pill's first member: the cover then sits 9.5pt
# inside the capsule, where the workspace chip, the other circle at a pill's
# end, sits too. At 8 it was 7.5, visibly tighter at one end than the other.
# The slot has an explicit width, so the padding slides the cover rather than
# widening the pill; the title's own padding moved up by the same 2 to keep the
# gap between them.
sketchybar --add item media_disc left \
  --set media_disc \
    drawing=off \
    display=1 \
    width=28 \
    label.drawing=off \
    label.padding_left=0 \
    label.padding_right=0 \
    icon.drawing=off \
    padding_left=10 \
    padding_right=3 \
    background.drawing=on \
    background.color="$TRANSPARENT" \
    background.height=24 \
    background.corner_radius=12 \
    background.image.drawing=on \
    background.image.scale="$MEDIA_DISC_SCALE" \
    background.image.corner_radius=12 \
    script="$PLUGIN_DIR/media_controls.sh" \
    click_script="$PLUGIN_DIR/card_click.sh media_pill"

sketchybar --add item media_wave left \
  --set media_wave \
    drawing=off \
    display=1 \
    width=204 \
    label.drawing=off \
    label.padding_left=0 \
    label.padding_right=0 \
    icon.drawing=off \
    icon.padding_left=0 \
    icon.padding_right=0 \
    background.drawing=on \
    background.color="$TRANSPARENT" \
    background.height=24 \
    background.image.drawing=on \
    background.image.scale=1.0 \
    click_script="$PLUGIN_DIR/card_click.sh media_pill"

sketchybar --add item media left \
  --set media \
    drawing=off \
    display=1 \
    label.drawing=off \
    label.padding_left=0 \
    label.padding_right=0 \
    icon.drawing=on \
    icon.font="$BAR_FONT:$BAR_FONT_WEIGHT:$BAR_FONT_SIZE" \
    icon.color="$MEDIA_COLOR" \
    icon.padding_left=9 \
    icon.padding_right=0 \
    click_script="$PLUGIN_DIR/card_click.sh media_pill"

# The `~` between title and artist is its own item, for the same reason the title
# and artist are two items: it needs treatment neither of them wants. Its own
# colour (dimmer than both, see MEDIA_SEP_COLOR), and no click_script, so the
# separator is not a target that opens Spotify.
#
# Symmetric by padding rather than by spaces in the string. 7pt on each side of
# the glyph here, with `media` at icon.padding_right=0 and `media_artist` at
# label.padding_left=0, puts an identical 9pt gap on both sides once the 1pt
# item paddings are counted. A "~ " prefix on the artist label instead would
# give 7pt on the left and one space character (~3.6pt) on the right, and that
# lopsidedness is visible at this size.
#
# Drawn and hidden by mediawatch alongside media_artist: a separator with nothing
# on the far side of it is worse than no separator.
sketchybar --add item media_sep left \
  --set media_sep \
    drawing=off \
    display=1 \
    icon.drawing=off \
    label="~" \
    label.font="$BAR_FONT:$BAR_FONT_WEIGHT:$BAR_FONT_SIZE" \
    label.color="$MEDIA_SEP_COLOR" \
    label.padding_left=7 \
    label.padding_right=7 \
    click_script="$PLUGIN_DIR/card_click.sh media_pill"

sketchybar --add item media_artist left \
  --set media_artist \
    drawing=off \
    display=1 \
    icon.drawing=off \
    label.max_chars="$MEDIA_LABEL_MAX" \
    label.font="$BAR_FONT:$BAR_FONT_WEIGHT:$BAR_FONT_SIZE" \
    label.color="$MEDIA_ARTIST_COLOR" \
    label.padding_left=0 \
    label.padding_right="$PILL_TEXT_PAD" \
    click_script="$PLUGIN_DIR/card_click.sh media_pill"

# The three pills. Brackets have to come last because they can only group items
# that already exist. Negative background padding widens the fill past the outer
# labels so the text is not crowded against the corner radius.
#
# **A bracket's `bounding_rects` reports the span of its members, not the fill it
# draws.** The real gap at each end is that span plus the matching negative
# padding, so reading the query alone understates both ends by 6pt. Worth knowing
# before trying to measure any of this: the left pill once measured symmetric
# while reading 9pt lopsided on screen.
#
# All three pills land on the same 16pt inner inset, and it is built rather than
# tuned: this shared -6 plus exactly 10pt of padding on the first and last member
# of every pill. No per-pill overrides, so the ends cannot drift apart.
#
# 16 is set by the left pill and is not free choice. The active workspace chip is
# a filled circle sitting in a 15pt corner radius, and a circle needs more
# clearance from that arc than text does; see the LEADING_PAD note above.
#
# The 10 lives on the members, not on the bracket, because the bracket wraps each
# member's whole box. Widening the fill leftward instead is not an option: the bar
# margin is 10pt, so a more negative padding_left runs the fill off the screen
# edge rather than moving content inward.
pill=(
  y_offset="$PILL_Y"
  background.drawing=on
  background.color="$PILL_COLOR"
  background.border_width=1
  background.border_color="$BORDER_COLOR"
  background.height="$PILL_HEIGHT"
  background.corner_radius="$PILL_RADIUS"
  background.padding_left=-6
  background.padding_right=-6
  background.shadow.drawing=on
  background.shadow.color="$SHADOW_COLOR"
  background.shadow.distance=3
  background.shadow.angle=270
)

# The badges that are off go now, with their cards, before the first script
# runs: SketchyBar runs none until the `--update` at the end, so a badge that is
# off never polls, never reads a login and never shows. Taken out here rather
# than wrapped in a condition each, because each is a long block of item, card
# rows and notes, and one loop is the one place to read.
for b in "${BADGE_ORDER[@]}"; do
  # The badge, then its card rows. SketchyBar's patterns are plain: no anchors
  # or groups, which is why it is two.
  badge_on "$b" || sketchybar --remove "$b" --remove "/$b\..*/" 2>/dev/null
done
badges_on=()
for b in "${BADGE_ORDER[@]}"; do badge_on "$b" && badges_on+=("$b"); done

sketchybar --add bracket left_pill left_pad '/workspace\..*/' '/front_app\..*/' \
  --set left_pill "${pill[@]}"

sketchybar --add bracket media_pill media_wave media_disc media media_sep media_artist \
  --set media_pill "${pill[@]}" \
    display=1 \
    popup.align=center \
    popup.y_offset="$CARD_Y_OFFSET" \
    popup.height=30 \
    popup.horizontal=on \
    popup.background.drawing=on \
    popup.background.color="$PILL_COLOR" \
    popup.background.border_width=1 \
    popup.background.border_color="$BORDER_COLOR" \
    popup.background.corner_radius=15 \
    popup.background.shadow.drawing=on \
    popup.background.shadow.color="$SHADOW_COLOR" \
    popup.background.shadow.distance=4 \
    popup.background.shadow.angle=270

sketchybar --add bracket right_pill clock \
  --set right_pill "${pill[@]}"

# The three badges get a pill of their own, the same chrome as the others, so
# the right end reads as two capsules rather than a capsule and three loose
# marks. Main display only, like the badges it holds.
sketchybar --add bracket badge_pill "${badges_on[@]}" \
  --set badge_pill "${pill[@]}" \
    display=1

# The bar sits under the native menu bar, so something has to notice the hover
# reveal and get the bar out of the way. SketchyBar has no event for it.
#
"$PLUGIN_DIR/menubar_watch.sh"

# After a display change or a wake, both pointer watchers get a clean start
# once the displays have settled; see plugins/display_settle.sh. Restarting on
# the first display_change, mid lid-change, left menubarwatch measuring a
# layout that was already gone: the bar receded at random and cards shut.
sketchybar --add item display_settle left \
  --set display_settle drawing=off updates=on width=0 \
    script="$PLUGIN_DIR/display_settle.sh" \
  --subscribe display_settle display_change system_woke

# And every 20 seconds regardless: a pill stacked over its badges, or workspace
# chips left on a screen that is gone, healed within moments rather than at the
# next screen change. See plugins/bar_health.sh.
sketchybar --add item bar_health left \
  --set bar_health drawing=off updates=on width=0 update_freq=20 \
    script="$PLUGIN_DIR/bar_health.sh"

# The popup cards: opened by a click, closed when the pointer leaves. A separate
# watcher because SketchyBar's own mouse events are not usable here; see
# assets/hoverwatch.swift for the measurement. Started after the two other watchers and before the brackets,
# which is fine: it queries the bar for its rectangles rather than being told
# them, so it does not care what exists yet.
"$PLUGIN_DIR/hover_watch.sh"

# The badges' transitions between states; see assets/motionwatch.swift.
# Started before the badge plugins first run, so a change on the first poll
# already animates.
"$PLUGIN_DIR/motion_watch.sh"

# Transport controls, on the card that clicking the pill opens. Alt-clicking the
# pill plays or pauses, the division the whole bar follows: click to see,
# alt-click to act. Both routed through hoverwatch, so the card has one owner:
# when a click toggle and hoverwatch drove the same flag from opposite ends, a
# click to close was undone by the next poll a frame later.
#
# It hangs off the bracket, not off any one item in it, and that is the whole
# trick to centring it. A popup can only be aligned left, centre or right of its
# parent and there is no x offset, so centred on the cover it opened 68pt clear
# of the pill's left edge, and centred on the title it drifted with the track:
# right of centre for a podcast with no artist, left of centre for a song with
# one. The bracket *is* the pill, so centred on that it is centred full stop.
#
# Which is why this block sits at the very bottom of the file. A bracket can only
# be declared once its members exist, and a popup member can only be attached to
# a parent that already exists, so the order is members, bracket, then these.
#
# `popup.horizontal=on`, so this card is a strip rather than a stack. It is the
# only horizontal popup here, and it is what makes five glyphs read as a
# transport instead of as five menu entries.
#
# `y_offset=-4` on every button, against the text popups' 0. These glyphs carry
# a much taller ascent than a line of Avenir, so centred on the row's baseline
# they hung out through the top of the card; the nudge puts the drawn shape in
# the middle rather than the box it is measured in.
#
# They are named `transport.*` and not `media.*`. Nothing drives `/^media/` any
# more, but something did once, and the name that bit then would bite again the
# moment anything does. The popup parent is `popup.media_pill`.
#
# `label.drawing=off` with both paddings at 0 on every button, for the reason the
# media items carry it: menubar_reveal.sh restores with a blanket
# `label.drawing=on`, and an empty label that is drawing still holds its padding,
# which would space the strip out unevenly the first time the menu bar is peeked.
#
# Shuffle and repeat are actions with no state shown. media-control does not
# report either one, so lighting them would be a guess; see media_controls.sh.
# Name, glyph, action, read three at a time. An action is either a
# media-control command or, for the last button, `spotify`.
#
# The glyphs are literal characters in this file, not `$'\\U000F04AE'` escapes.
# zsh only decodes \\U inside $'...' *and* only when the locale can encode the
# result. The LaunchAgent hands the daemon a LANG, so at login an escape would
# survive; a `sketchybar --reload` typed into a shell without one dies on
# "character not in range" and takes the whole rc with it. A literal character
# needs no locale either way.
#
# Order is transport, divider, modes. The three that move the music sit together
# on the left where the hand goes first, and the two that change how it plays
# are behind a hairline with the one that leaves for the app.
transport_buttons=(
  prev       󰒮 previous-track
  playpause  󰐊 toggle-play-pause
  next       󰒭 next-track
  divider    -      -
  shuffle    󰒟 toggle-shuffle
  repeat     󰑖 toggle-repeat
)

# `popup.height` sets the row band and `y_offset=0` leaves the glyphs centred in
# it. An earlier revision carried -4 to rescue a strip that was drawing clipped
# through the top of its own card, which turned out to be the naming problem
# below rather than a metrics problem: the offset was never 0 at all, it was the
# 16 these items inherited while they matched `/^media/`. With the names fixed
# the nudge stopped being a correction and started being a 4pt drop.
#
# They are named `transport.*` and not `media.*`. A `/^media/` selector once
# swallowed them whole and drew the strip clipped through the top of its own
# card; nothing uses one now, but the name costs nothing to keep safe. The popup
# parent is `popup.media_pill`.
for (( i = 1; i <= ${#transport_buttons}; i += 3 )); do
  name="${transport_buttons[i]}"
  glyph="${transport_buttons[i + 1]}"
  command="${transport_buttons[i + 2]}"

  if [[ "$name" == divider ]]; then
    # A drawn hairline rather than a glyph or a gap. A "|" in this font is taller
    # than the buttons and reads as one more symbol in a row of symbols, and
    # empty space alone cannot separate two groups that are already evenly
    # spaced.
    sketchybar --add item transport.divider popup.media_pill \
      --set transport.divider \
        y_offset=0 \
        width=1 \
        padding_left=7 \
        padding_right=7 \
        icon.drawing=off \
        label.drawing=off \
        label.padding_left=0 \
        label.padding_right=0 \
        background.drawing=on \
        background.color="$BORDER_COLOR" \
        background.height=14
    continue
  fi

  sketchybar --add item "transport.$name" popup.media_pill \
    --set "transport.$name" \
      y_offset=0 \
      width=32 \
      icon="$glyph" \
      icon.drawing=on \
      icon.font="Hack Nerd Font:Bold:15.0" \
      icon.color="$TEXT_COLOR" \
      icon.align=center \
      icon.width=32 \
      icon.padding_left=0 \
      icon.padding_right=0 \
      label.drawing=off \
      label.padding_left=0 \
      label.padding_right=0 \
      background.drawing=off \
      click_script="$PLUGIN_DIR/media_controls.sh press $command"
done

# No `media_change` subscription here, though it would be the obvious signal: it
# never fires on macOS 26, verified with a probe item across a play and a pause.
# The strip is refreshed by `plugins/on_open_media_pill.sh`, which hoverwatch
# runs as the card appears.

# The two past the divider step back to grey. They are modes rather than moves
# and they are the two that cannot show their own state, so keeping them dim
# leaves the three controls that act on the music now as the only bright run.
sketchybar --set transport.shuffle icon.color="$MUTED_COLOR" \
           --set transport.repeat  icon.color="$MUTED_COLOR"

# Run it once at load. An item's
# script fires on its subscriptions and its own timer, never on `--update`, and
# this one is on a 120s timer: without this line the badge is simply absent for
# two minutes after every reload, with nothing on the bar to click. Backgrounded
# because it makes a network call, and a reload should not wait on the internet.
# The Claude badge retries, the battery does not. Both are kicked here because an
# item's script never runs on `--update`, but the Claude one reaches the network
# and the login keychain, and at service start neither is reliably there yet: on
# a cold `brew services restart` the first attempt came back empty and the badge
# stayed blank until the next 120s tick. Three tries thirty seconds apart cover
# the gap, and the script exits non-zero when it could not draw, so a success
# breaks out immediately.
#
# Deliberately not more or faster. The endpoint rate-limits: a morning of reloads
# while working on this file earned an HTTP 429, which is exactly the failure
# that used to blank the badge. `CLAUDE_USAGE_DEBUG=1 plugins/claude_usage.sh`
# prints the reason when it happens again.
# The Now Playing watcher starts last, after every item it writes exists. It
# owns the transport strip's play/pause glyph, and started earlier, the strip
# created further down this file came up with the rc's default glyph over the
# one mediawatch had already set, and stayed wrong until the next toggle.
"$PLUGIN_DIR/media_watch.sh"

badge_on claude && ( for attempt in 1 2 3; do
    "$PLUGIN_DIR/claude_usage.sh"
    # 0 drew something, 2 is a rate limit and means stop asking. Only a plain
    # failure is worth another go.
    [[ $? -ne 1 ]] && break
    sleep 30
  done ) &
for b in battery orbstack caffeinate wifi; do
  badge_on "$b" && "$PLUGIN_DIR/$b.sh" &
done
# Workspaces and app labels at load, rather than at the first focus change.
"$PLUGIN_DIR/aerospace_sync.sh" &

sketchybar --update
