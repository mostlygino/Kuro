<?xml version="1.0" encoding="UTF-8"?>
<!--
  wifiinfo is a one-shot CLI in every other respect. It is a bundle for one
  reason: since macOS 14 the name of the Wi-Fi network is location data, and a
  Location Services permission needs a bundle identifier, a usage description
  and a stable signature to attach to. LSUIElement keeps it out of the Dock
  while still allowing the one permission prompt to appear.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleExecutable</key>
	<string>wifiinfo</string>
	<key>CFBundleIdentifier</key>
	<string>sh.kuro.sketchybar.wifiinfo</string>
	<key>CFBundleName</key>
	<string>Kuro Wi-Fi</string>
	<key>CFBundleDisplayName</key>
	<string>Kuro Wi-Fi</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>1.0</string>
	<key>CFBundleVersion</key>
	<string>1</string>
	<key>LSUIElement</key>
	<true/>
	<key>LSMinimumSystemVersion</key>
	<string>14.0</string>
	<key>NSLocationUsageDescription</key>
	<string>Kuro reads the name of the Wi-Fi network you are on, to show it in the menu bar. macOS treats a network name as location data. Nothing is stored or sent anywhere.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>Kuro reads the name of the Wi-Fi network you are on, to show it in the menu bar. macOS treats a network name as location data. Nothing is stored or sent anywhere.</string>
</dict>
</plist>
